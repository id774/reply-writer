# Copy this file to .env and adjust the values.
# Keep the file readable by the service user only (chmod 600).
#
# The four generation settings below are required and have no runtime
# defaults. This example already names the only wire protocol this
# version supports, openai-compatible. The API token, base URL and
# model stay empty and must be filled in before generation can start.
# Nothing here chooses a generation service implicitly: the destination
# is still the GENERATION_BASE_URL the operator supplies.

# Wire protocol of the endpoint. Required.
# 'openai-compatible' is the only value this version accepts. An
# unknown one is refused rather than read as this one.
GENERATION_BACKEND=openai-compatible

# API key or Bearer token of the endpoint. Required.
# Left empty on purpose: a placeholder here would read as a configured
# token, so the failure would appear only once a message had been
# pasted and a request spent.
GENERATION_API_TOKEN=

# Base URL of the endpoint. Required, https only.
# Left empty on purpose, so that no endpoint is chosen by copying this
# file. Include the version path and stop there: the SDK appends
# /chat/completions itself, and a URL that already carries it is
# refused at startup. The form is https://<host>/v1
GENERATION_BASE_URL=

# Model used for generation. Required; no default is shipped, because
# the available models differ per endpoint and change over time. Read
# the name off the endpoint's own list of available models.
GENERATION_MODEL=

# How a structured answer is asked for.
#   prompt-json  send no response_format; the prompt carries the
#                contract. Works with an endpoint or a model that
#                rejects the parameter.
#   json-object  send response_format={"type":"json_object"} as well.
# There is no automatic choice: trying one and retrying with the other
# would turn one generation into two requests, and hide which of them
# the reply came from.
GENERATION_RESPONSE_MODE=prompt-json

# Seconds allowed for one request. The answer is not streamed, so this
# is the whole generation. Raising it means raising the gunicorn
# --timeout (240) and the Apache ProxyTimeout (300) with it.
GENERATION_TIMEOUT=120

# Retries left to the SDK. 0 means one action by the person spends one
# request, which is what keeps it possible to say afterwards how many
# times a message was sent and where.
GENERATION_MAX_RETRIES=0

# Sent only when set, so that a model refusing the parameter still runs.
GENERATION_TEMPERATURE=

# Kimi K3:
# GENERATION_BACKEND=openai-compatible
# GENERATION_API_TOKEN=<Kimi API key>
# GENERATION_BASE_URL=https://api.moonshot.ai/v1
# GENERATION_MODEL=kimi-k3
# GENERATION_RESPONSE_MODE=prompt-json
# GENERATION_TEMPERATURE=
# GENERATION_OUTPUT_TOKEN_PARAMETER=max_completion_tokens

# Request field that carries MAX_OUTPUT_TOKENS.
# max_tokens preserves the existing compatibility path.
# max_completion_tokens is selected explicitly for endpoints that use
# the current field. The application never guesses from a model or URL.
GENERATION_OUTPUT_TOKEN_PARAMETER=max_tokens

# Upper bound of one response. A reply is short; this only has to be
# large enough that a long one is not cut off.
MAX_OUTPUT_TOKENS=2000

# Upper bound of the received message in characters, enforced by the
# generation core for both Web and CLI use. The Web layer separately
# rejects a whole HTTP request body over 1 MiB before parsing the form.
MAX_INPUT_CHARS=8000

# Upper bound of the direction field. A few lines is the expected shape.
MAX_POLICY_CHARS=2000

# Directory holding the prompt files.
PROMPT_DIR=prompts

# Level of the application log. No level writes a received message, a
# direction or a generated reply to it. An unknown level name uses INFO.
LOG_LEVEL=INFO

# Port of the Flask development server and the Procfile gunicorn
# command. The systemd deployment example binds explicitly to
# 127.0.0.1:8091; changing that production port means changing the
# service unit and the Apache proxy target together.
PORT=8091
